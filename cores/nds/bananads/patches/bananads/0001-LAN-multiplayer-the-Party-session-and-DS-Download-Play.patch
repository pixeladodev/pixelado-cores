+
+bool wfc_settings_get(const melonDS::Firmware& fw, std::vector<uint8_t>& out) {
+    if (!fw.Buffer() || !wfc_layout_ok(fw)) return false;
+    const u8* p = fw.GetExtendedAccessPointPosition();
+    out.assign(p, p + kWfcSettingsSize);
+    return true;
+}
