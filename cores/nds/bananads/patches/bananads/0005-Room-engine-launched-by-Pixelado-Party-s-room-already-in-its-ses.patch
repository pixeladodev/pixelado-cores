+// A nickname as the firmware keeps it: UTF-8 (Pixelado Party's profile: "ñ", "é") to the firmware's UCS-2, 10
+// characters at most
+static std::u16string nick_ucs2(const std::string& s) {
+    std::u16string out;
+    for (size_t i = 0; i < s.size() && out.size() < 10;) {
+        const unsigned char c = (unsigned char)s[i];
+        char32_t u = c;
+        size_t n = 1;
+        if (c >= 0xE0 && i + 2 < s.size()) { u = (c & 0x0F) << 12 | (s[i + 1] & 0x3F) << 6 | (s[i + 2] & 0x3F); n = 3; }
+        else if (c >= 0xC0 && i + 1 < s.size()) { u = (c & 0x1F) << 6 | (s[i + 1] & 0x3F); n = 2; }
+        out.push_back((char16_t)u);
+        i += n;
+    }
+    return out;
+}
