--- /dev/null
+++ b/bananads/src/roomctl.cpp
@@ -0,0 +1,110 @@
+// See roomctl.h. One thread: it connects to the room's socket, says HELLO, watches the local wireless state a few
+// times a second and reads the room's lines. END stops the game as SIGTERM does (the saves written).
+#include "roomctl.h"
+
+#include "config.h"
+#include "emu.h"
+
+#include <atomic>
+#include <csignal>
+#include <cstdio>
+#include <cstring>
+#include <string>
+#include <thread>
+
+#include <poll.h>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+#include "Platform.h"
+
+using melonDS::Platform::Log;
+using melonDS::Platform::LogLevel;
+
+namespace bananads {
+
+static std::thread g_thread;
+static std::atomic<bool> g_run{false}, g_ended{false};
+static int g_fd = -1;
+
+static bool send_line(const std::string& l) {
+    if (g_fd < 0) return false;
+    const std::string s = l + "\n";
+    return send(g_fd, s.data(), s.size(), MSG_NOSIGNAL) == (ssize_t)s.size();
+}
+
+static void loop(Emu* emu, std::string path, std::string gid) {
+    // the room's party-room is up before the engine; a few tries in case it is slow to answer
+    for (int i = 0; i < 20 && g_run && g_fd < 0; i++) {
+        int fd = socket(AF_UNIX, SOCK_STREAM, 0);
+        sockaddr_un su{};
+        su.sun_family = AF_UNIX;
+        snprintf(su.sun_path, sizeof su.sun_path, "%s", path.c_str());
+        if (fd >= 0 && connect(fd, (sockaddr*)&su, sizeof su) == 0) g_fd = fd;
+        else {
+            if (fd >= 0) close(fd);
+            usleep(100000);
+        }
+    }
+    if (g_fd < 0) {
+        Log(LogLevel::Warn, "[room] no room socket at %s: playing without it\n", path.c_str());
+        return;
+    }
+    Log(LogLevel::Info, "[room] on the room's socket (%s)\n", path.c_str());
+    send_line("HELLO role=engine engine=ds proto=1 gid=" + gid + " caps=pause-own");
+    bool said = false;
+    std::string buf;
+    while (g_run) {
+        pollfd pf{g_fd, POLLIN, 0};
+        if (poll(&pf, 1, 200) > 0) {
+            char b[512];
+            ssize_t r = recv(g_fd, b, sizeof b, 0);
+            if (r <= 0) {
+                Log(LogLevel::Info, "[room] the room's socket closed\n");
+                break;
+            }
+            buf.append(b, (size_t)r);
+            size_t nl;
+            while ((nl = buf.find('\n')) != std::string::npos) {
+                const std::string line = buf.substr(0, nl);
+                buf.erase(0, nl + 1);
+                if (line.compare(0, 4, "END ") == 0 || line == "END") {
+                    Log(LogLevel::Info, "[room] the room ended the game (%s)\n", line.c_str());
+                    g_ended = true;
+                    raise(SIGTERM);   // (the frontend quits as for a shutdown: the save written)
+                }
+            }
+        }
+        if (!said) {
+            const Emu::LanStatus st = emu->lan_status();
+            if (st.state == Emu::LanState::Ready && st.mode == Emu::LanMode::Host) {
+                said = send_line("SESSION state=listening");
+                Log(LogLevel::Info, "[room] listening, told the room\n");
+            } else if (st.state == Emu::LanState::Ready && st.mode == Emu::LanMode::Join) {
+                said = send_line("SESSION state=connected");
+                Log(LogLevel::Info, "[room] in the host's session, told the room\n");
+            }
+        }
+    }
+}
+
+void roomctl_start(Emu& emu, const Config& cfg) {
+    const std::string path = cfg.str("room.ctl", "");
+    if (path.empty() || g_run) return;
+    g_run = true;
+    g_thread = std::thread(loop, &emu, path, cfg.str("room.gid", ""));
+}
+
+void roomctl_stop() {
+    if (!g_run) return;
+    if (g_fd >= 0) send_line(g_ended ? "GAME state=ended reason=end" : "GAME state=ended reason=quit");
+    g_run = false;
+    if (g_thread.joinable()) g_thread.join();
+    if (g_fd >= 0) close(g_fd);
+    g_fd = -1;
+}
+
+bool roomctl_ended() { return g_ended; }
+
+}  // namespace bananads
diff --git a/bananads/src/roomctl.h b/bananads/src/roomctl.h
new file mode 100644
index 0000000..5c6c48f
--- /dev/null
+++ b/bananads/src/roomctl.h
@@ -0,0 +1,17 @@
+// Pixelado Party's room (PXROOM/1, its local socket): an engine started by the room says what its local wireless
+// session is doing (listening as the host, connected as a guest) and when it ends, and quits when the room ends the
+// game (END). room.ctl=<socket> turns it on; without it, or if the socket isn't there, nothing changes.
+#pragma once
+
+namespace bananads {
+
+class Config;
+class Emu;
+
+void roomctl_start(Emu& emu, const Config& cfg);
+// the game is over (quit by the player, or by END): GAME said, the thread gone. Before the Emu goes
+void roomctl_stop();
+// the room ended the game (END): the process exits with 10 (ROOM-PROTOCOL.md §12.1)
+bool roomctl_ended();
+
+}  // namespace bananads
