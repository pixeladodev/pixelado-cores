+// [fw] the user settings as the game sees them: the RAM that direct boot fills (0x027FFC80, what OS_GetOwnerInfo reads)
+void Emu::log_user_ram(const char* when) {
+    if (!nds_ || !cfg_.flag("firmware.profile", false)) return;
+    std::string shown;
+    const unsigned len = nds_->ARM9Read16(0x027FFC80 + 0x1A);
+    for (unsigned i = 0; i < len && i < 10; i++) {
+        const unsigned c = nds_->ARM9Read16(0x027FFC80 + 6 + 2 * i);
