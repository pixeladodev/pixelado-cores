+    Log(LogLevel::Info, "[fw] the game's RAM user data (%s): nickname \"%s\", colour %u, language %u\n", when,
+        shown.c_str(), (unsigned)nds_->ARM9Read8(0x027FFC80 + 2), (unsigned)(nds_->ARM9Read16(0x027FFC80 + 0x64) & 7));
+}
