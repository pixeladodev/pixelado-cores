+    int opts_tick(int* vol, int* bri) override { return bmenu_ext_tick(vol, bri); }
+    void opts_close() override { bmenu_ext_close(); }
+    void sound(int id) override { bmenu_ext_sound(id); }
+    void quit() override { mh->quit = true; }
+    int menu_held_ms() override {
+        // (the governor counts the game's frames as mh_poll does)
+        if (mh->feed) mh->feed->frames = mh->dp->made.load();
+        for (auto& d : *mh->devs) {
+            input_event e[64];
+            ssize_t n;
+            while ((n = read(d.fd, e, sizeof e)) > 0)
+                for (int j = 0; j < n / (int)sizeof(input_event); j++) {
+                    const input_event& x = e[j];
+                    if (x.type != EV_KEY || x.value == 2 || d.touch) continue;
+                    int bit = x.code == BTN_MODE || x.code == KEY_F1 ? 1 : x.code == BTN_Z ? 2 : x.code == KEY_F2 ? 4
+                            : x.code == BTN_THUMBL ? 8 : 0;
+                    if (!bit) continue;
+                    if (x.value) {
+                        if (!held_codes) held_since = now_us();
+                        held_codes |= bit;
+                    } else {
+                        held_codes &= ~bit;
+                        if (!held_codes) held_since = 0;
+                    }
+                }
+        }
+        return held_codes && held_since ? (int)((now_us() - held_since) / 1000) : 0;
+    }
+    bool stopping() override { return g_quit.load(); }
+    void log(const char* line) override { Log(LogLevel::Info, "%s", line); }
+};
