+                    mprec::NResendCmd, mprec::NResendAck, mprec::NSaved, mprec::SavedMaxUS / 1000.0, mprec::NGraceOut,
+                    mprec::NDupCmd, mprec::NResendReply, mprec::NDupAck, mprec::NNoAck, mprec::NDropped,
+                    mprec::NDelayed, mprec::NDelayed ? mprec::DelayedSumUS / 1000.0 / mprec::NDelayed : 0.0);
+            mprec::NResendCmd = mprec::NDupCmd = mprec::NResendReply = mprec::NSaved = mprec::NGraceOut = mprec::NDropped = 0;
+            mprec::NResendAck = mprec::NDupAck = mprec::NNoAck = mprec::NDelayed = 0;
+            mprec::DelayedSumUS = 0;
+            mprec::SavedMaxUS = 0;
             landiag::WaitUS = landiag::WaitMaxUS = 0;
             landiag::NWaits = landiag::NReplyTimeout = 0;
             landiag::SReply.Reset(); landiag::SRtt.Reset(); landiag::SPre.Reset(); landiag::SRun.Reset(); landiag::SEmu.Reset();
@@ -1555,6 +1641,61 @@ int LAN::SendPacketGeneric(u32 type, u8* packet, int len, u64 timestamp)
 
     if (!Repeating) RepeatCheck(packet, type, len, timestamp);
 
+    if (((type & 0xFFFF) >= 1 && (type & 0xFFFF) <= 3) && mprec::Drop())
+    {
+        mprec::NDropped++;
+        return len;
+    }
+
+    if (((type & 0xFFFF) >= 1 && (type & 0xFFFF) <= 3) && mprec::DelayMS())
+    {
+        const u64 now = Platform::GetUSCount();
+        u64 at = std::max(now + mprec::DelayUS(), DelayLastAt);
+        DelayLastAt = at;
+        mprec::NDelayed++;
+        mprec::DelayedSumUS += at - now;
+        DelayQueue.push(Delayed{at, type, packet && len > 0 ? std::vector<u8>(packet, packet + len) : std::vector<u8>(), timestamp});
+        FlushDelayed();
+        return len;
+    }
+
+    SendNow(type, packet, len, timestamp);
+    return len;
+}
+
+// enet_host_service, but a blocking wait doesn't hold the test delay's frames back past their time: it waits in
+// slices up to the next one due and sends each as it comes due
+int LAN::ServiceDelayed(ENetEvent* event, int timeout)
+{
+    if (DelayQueue.empty()) return enet_host_service(Host, event, timeout);
+    const u32 start = (u32)Platform::GetMSCount();
+    for (;;)
+    {
+        FlushDelayed();
+        const int left = timeout - (int)((u32)Platform::GetMSCount() - start);
+        if (DelayQueue.empty() || left <= 0) return enet_host_service(Host, event, std::max(0, left));
+        const u64 nowus = Platform::GetUSCount();
+        const u64 due = DelayQueue.front().At;
+        int slice = due > nowus ? (int)((due - nowus + 999) / 1000) : 0;
+        if (slice > left) slice = left;
+        const int r = enet_host_service(Host, event, (enet_uint32)slice);
+        if (r != 0) return r;
+    }
+}
+
+void LAN::FlushDelayed()
+{
+    const u64 now = Platform::GetUSCount();
+    while (!DelayQueue.empty() && DelayQueue.front().At <= now)
+    {
+        Delayed& d = DelayQueue.front();
+        SendNow(d.Type, d.Data.empty() ? nullptr : d.Data.data(), (int)d.Data.size(), d.TS);
+        DelayQueue.pop();
+    }
+}
