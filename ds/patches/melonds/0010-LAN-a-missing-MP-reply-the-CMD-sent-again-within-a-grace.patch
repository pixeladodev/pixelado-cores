+// Pixelado: while the host waits out a radio gap and sends its CMD again (LAN.cpp, mprec: up to
+// BANANADS_LAN_GRACE_MS), a client doesn't run on without it: the step past a quiet host waits for the grace
+// plus 100 ms. With the grace off (0), the step comes after kHostQuietTries timeouts, as before.
+static u64 HostQuietStepMS()
+{
+    static int v = -1;
+    if (v < 0)
+    {
+        v = 300;
+        const char* e = getenv("BANANADS_LAN_GRACE_MS");
+        if (e && *e)
+        {
+            char* end = nullptr;
+            long n = strtol(e, &end, 10);
+            if (end && *end == 0 && n >= 0 && n <= 2000) v = (int)n;
+        }
+    }
+    return v ? (u64)v + 100 : 0;
+}
