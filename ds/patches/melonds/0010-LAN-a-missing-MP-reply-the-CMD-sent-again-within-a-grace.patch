 // BananaDS diagnostics: Debug level (BananaDS log.level 0), "[diag] LAN" prefix, rate-limited
+// Pixelado: lossless MP over a radio that sometimes goes quiet. Real DS hardware sends a CMD again while a
+// client's reply is missing; melonDS reports the client as failed at once (Wifi.cpp keeps that retry off), so
+// a game sees each late or lost packet. Most games shrug it off, but some (Mario Party DS) can end up in a
+// state their link never leaves: the picture stops while both sides keep talking. So, as the host: when the
+// replies are missing, wait up to the grace (BANANADS_LAN_GRACE_MS, default 300, 0 = off: the plain
+// MPRecvTimeout) and send the CMD again every BANANADS_LAN_RESEND_MS (default 20); as a client: a CMD that
+// comes in again (same timestamp) gets our reply to it again and is not handed to the DS twice. A radio gap
+// costs a stall, not an exchange. Grace only for players that replied lately (fewer than kGraceMisses CMDs in
+// a row missed), so a console that left costs one grace and then the usual timeout.
+// BANANADS_LAN_DROP (test only, 0-500 per mille, default 0) drops that share of the MP frames we send.
+// BANANADS_LAN_DELAY_MS (test only, 0-200, default 0) delays the MP frames we send like a weak radio: in stretches
+// of half a second, BANANADS_LAN_DELAY_BAD per cent of them (default 10) are bad (each frame 0 to that many ms late)
+// and the rest good (0-1 ms); frames keep their order. Nothing is lost.
+// A line a second when any of it happened: "[diag] LAN recovery".
+namespace mprec
+{
+const int kGraceMisses = 3;
+static int EnvInt(const char* name, int def, int lo, int hi)
+{
+    const char* e = getenv(name);
+    if (!e || !*e) return def;
+    char* end = nullptr;
+    long n = strtol(e, &end, 10);
+    if (end && *end == 0 && n >= lo && n <= hi) return (int)n;
+    Platform::Log(Platform::LogLevel::Warn, "LAN: %s=%s ignored (%d-%d)\n", name, e, lo, hi);
+    return def;
+}
+static int GraceMS() { static int v = -1; if (v < 0) v = EnvInt("BANANADS_LAN_GRACE_MS", 300, 0, 2000); return v; }
+static int ResendMS() { static int v = -1; if (v < 0) v = EnvInt("BANANADS_LAN_RESEND_MS", 20, 5, 200); return v; }
+static int DropPermille() { static int v = -1; if (v < 0) v = EnvInt("BANANADS_LAN_DROP", 0, 0, 500); return v; }
+static bool Drop()
+{
+    if (!DropPermille()) return false;
+    static u32 x = 0;
+    if (!x) x = (u32)Platform::GetUSCount() | 1;
+    x ^= x << 13; x ^= x >> 17; x ^= x << 5;
+    return (x % 1000) < (u32)DropPermille();
+}
+static u32 Rand()
+{
+    static u32 x = 0;
+    if (!x) x = (u32)Platform::GetUSCount() | 1;
+    x ^= x << 13; x ^= x >> 17; x ^= x << 5;
+    return x;
+}
+static int DelayMS() { static int v = -1; if (v < 0) v = EnvInt("BANANADS_LAN_DELAY_MS", 0, 0, 200); return v; }
+static int DelayBadPct() { static int v = -1; if (v < 0) v = EnvInt("BANANADS_LAN_DELAY_BAD", 10, 0, 100); return v; }
+static u64 DelaySegUntil;
+static bool DelayBad;
+static u64 DelayUS()   // how late this frame goes out
+{
+    const u64 now = Platform::GetUSCount();
+    if (now >= DelaySegUntil) { DelayBad = (int)(Rand() % 100) < DelayBadPct(); DelaySegUntil = now + 500000; }
+    const u64 max = (u64)DelayMS() * 1000;
+    if (!DelayBad) return Rand() % 1001;
+    return Rand() % (max + 1);
+}
+static int NResendCmd, NDupCmd, NResendReply, NSaved, NGraceOut, NDropped, NResendAck, NDupAck, NNoAck, NDelayed;
+static u64 SavedMaxUS, DelayedSumUS;
+}
