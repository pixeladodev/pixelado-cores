+bool LAN::TakeDuplicateCmd(ENetPacket* packet)
+{
+    if (!mprec::GraceMS()) return false;
+    MPPacketHeader* header = (MPPacketHeader*)&packet->data[0];
+    if ((header->Type & 0xFFFF) != 1) return false;
+    if (!SeenCmdValid || header->Timestamp != SeenCmdTS) return false;  // new, or not handed to the DS yet
+    // the host sent this CMD again: our reply didn't reach it (or hasn't been sent yet: then it goes out as usual)
+    mprec::NDupCmd++;
+    if (!LastReply.empty() && LastReplyForCmd == header->Timestamp)
+    {
+        if (packet->userData) LastHostPeer = (ENetPeer*)packet->userData;
+        SendPacketGeneric(LastReplyType, LastReply.data(), (int)LastReply.size(), LastReplyTS);
+        mprec::NResendReply++;
+    }
+    enet_packet_destroy(packet);
+    return true;
+}
+
+void LAN::ResendAck(u64 cmdts)
+{
+    // only the ACK of the exchange just before this CMD (emulated time restarts with each game)
+    if (!LastAckValid || LastAck.empty() || LastAckTS >= cmdts || cmdts - LastAckTS > 100000) return;
+    SendPacketGeneric(3, LastAck.data(), (int)LastAck.size(), LastAckTS);
+    mprec::NResendAck++;
+}
+
+void LAN::ResendCmd()
+{
+    if (!LastCmdValid || LastCmd.empty()) return;
+    ResendAck(LastCmdTS);
+    SendPacketGeneric(1, LastCmd.data(), (int)LastCmd.size(), LastCmdTS);
+    mprec::NResendCmd++;
+}
