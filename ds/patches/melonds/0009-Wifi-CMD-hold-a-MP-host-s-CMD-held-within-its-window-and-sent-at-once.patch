From: Pixelado Dev <350114043+pixeladodev@users.noreply.github.com>
Subject: [PATCH] Wifi: CMD hold, a MP host's CMD held back within its W_CMD_COUNT window and sent to the clients at once (BANANADS_LAN_CMD_HOLD_US, off by default)


---
diff --git a/src/Wifi.cpp b/src/Wifi.cpp
index 7d0f261..8d6d8fc 100644
--- a/src/Wifi.cpp
+++ b/src/Wifi.cpp
@@ -290,6 +290,78 @@ static inline void SlotWrite() { if (Pending) NSlotW++; }
 static inline void RamWrite(u16 a) { if (Pending && a + 2 > BufLo && a < BufHi) NBufW++; }
 }
 
+// Pixelado 0009, CMD hold (BANANADS_LAN_CMD_HOLD_US, 0 or unset: off): as a MP host, a CMD is held back up to that
+// many microseconds of emulated time before its transmission, within the room its W_CMD_COUNT window leaves (a real
+// DS holds it back the same way while the channel is busy), and it goes out to the clients at once, stamped with the
+// moment the emulated hardware will transmit it. Meanwhile the host keeps emulating, so the network's round trip
+// overlaps useful work and the reply is already in when the emulation reaches MP_RecvReplies. Measured in Mario
+// Party DS's DS Download Play: every CMD leaves ~1700 us of room (2026-11-20, the Pixelado 0008 diag).
+namespace hold
+{
+static const u32 kMargin = 150;   // us kept free in the window past the exchange (StartTX_Cmd asks for 100)
+static int MaxUS()
+{
+    static int v = -1;
+    if (v < 0)
+    {
+        const char* e = getenv("BANANADS_LAN_CMD_HOLD_US");
+        v = (e && *e) ? std::max(0, atoi(e)) : 0;
+        Log(LogLevel::Info, "LAN: CMD hold %s%d us\n", v ? "up to " : "off, ", v);
+    }
+    return v;
+}
+static bool PreSent;   // this CMD already went out to the clients (at its hold's start): the preamble's end doesn't send it
+// Armed: StartTX_Cmd chose a hold; the CMD goes out when the CMD slot really starts (its first ProcessTX), stamped
+// from there. Stamping it at StartTX_Cmd was wrong when another slot went first (a beacon: 5, 4, 3, 2 before the CMD
+// in the TX order): the CMD then went out up to ~700 us later than stamped, the clients' replies (stamped from the CMD)
+// came "older" than the host's time and were thrown away as stale, and both sides waited 25 ms (the p8 game: 211 of
+// 219 reply timeouts, 120-700 us stale).
+static bool Armed;
+static int NHeld, NShort;
+static s64 SumUS;
+// The clients' run-ahead. After a CMD's ack a client may run as far as the ack lets it (CmdCounter's rest of the
+// window) before it needs the host's next frame. A held CMD uses that rest up, so a client got almost no run-ahead
+// and had to emulate the whole hold after the next CMD reached it, before replying (the 2026-11-20 p5 game: the
+// client's reply went from 0.02 to 1.6 ms, and the round trip with it). So the ack adds the hold to the run-ahead:
+// the next CMD will be held at least that long, so it can't be stamped earlier than the client may run. Promised is
+// what the last ack added; a CMD held less than that (its window too small) is counted ("short").
+static u32 LastUS, Promised;
+// The promise is the smallest hold of the last 32 CMDs less 16 us: a window's room varies a few microseconds with the
+// CMD's length (1696-1704 us in Mario Party DS), and a hold rounds down to the timer's 8 us, so promising the last
+// hold broke the promise in most CMDs (the p6 game: the client ran ahead a few us each time, that added up, and the
+// session dropped after ~40 s at 60 fps). A client run past a CMD's stamp clamps it to its own time for good.
+static u32 Recent[32];
+// client side: host frames that came stamped in this client's past, a line a second "[diag] LAN late"
+static int NLate;
+static u64 LateUS, LateWin;
+// client side, for a host wait that times out ("[diag] LAN client wait"): the last CMD and what this client answered
+enum { RNone = 0, REarly = 1, RFrameEnd = 2, RDefaultEnd = 3, RBlank = 4 };
+static const char* RName[] = {"none yet", "frame at the CMD's arrival", "frame at the reception's end",
+                              "default at the reception's end", "blank"};
+static u64 LastCmdTS, LastCmdAt, LastReplyTS, LastReplyAt;
+static bool LastCmdLate;
+static int LastReplyKind, NWaitLogs;
+static void Replied(int kind, u64 ts) { LastReplyKind = kind; LastReplyTS = ts; LastReplyAt = Platform::GetUSCount(); }
+static void LateFlush()
+{
+    const u64 t = Platform::GetMSCount();
+    if (!LateWin) LateWin = t;
+    if (t - LateWin < 1000) return;
+    if (NLate) Log(LogLevel::Info, "[diag] LAN late: %d host frames stamped in this client's past, %llu us in all\n",
+                   NLate, (unsigned long long)LateUS);
+    NLate = 0; LateUS = 0; LateWin = t;
+}
+static int RecentN, RecentI;
+static u32 Promise()
+{
+    if (!LastUS) return 0;
+    u32 m = LastUS;
+    for (int i = 0; i < RecentN; i++) m = std::min(m, Recent[i]);
+    return m > 16 ? m - 16 : 0;
+}
+}
+
+
 // BananaDS diag-cmd-window (BANANADS_LAN_TIMEOUT_MS set; diagnostics only, behavior unchanged): as a MP host, how
 // much room the game leaves each CMD exchange and what the clients answer. The room ("slack") is CmdCounter, the
 // W_CMD_COUNT window the game armed, less the exchange's emulated duration when the CMD starts: the time a real
@@ -328,11 +400,13 @@ static void Flush()
     if (NCmd)
         Log(LogLevel::Info, "[diag] LAN cmd: n=%d fail=%d timeout=%d clients=%.2f len=%.0f gap_us=%.0f; cmdcount_us min=%lld "
             "mean=%.0f max=%lld; slack_us min=%lld mean=%.0f max=%lld noroom=%d; slack_ms <0.5=%d 0.5-1=%d 1-2=%d 2-4=%d "
-            "4-8=%d >=8=%d; replies=%d same=%d empty=%d\n",
+            "4-8=%d >=8=%d; replies=%d same=%d empty=%d; held=%d mean_us=%.0f short=%d\n",
             NCmd, NFail, NTimeout, (double)NClients / NCmd, (double)LenSum / NCmd, NGap ? (double)GapSum / NGap : 0.0,
             (long long)CntMin, (double)CntSum / NCmd, (long long)CntMax,
             (long long)(NSlack ? SlackMin : 0), NSlack ? (double)SlackSum / NSlack : 0.0, (long long)(NSlack ? SlackMax : 0),
-            NNoRoom, Bucket[0], Bucket[1], Bucket[2], Bucket[3], Bucket[4], Bucket[5], NRep, NSame, NEmpty);
+            NNoRoom, Bucket[0], Bucket[1], Bucket[2], Bucket[3], Bucket[4], Bucket[5], NRep, NSame, NEmpty,
+            hold::NHeld, hold::NHeld ? (double)hold::SumUS / hold::NHeld : 0.0, hold::NShort);
+    hold::NHeld = 0; hold::SumUS = 0; hold::NShort = 0;
     NCmd = NFail = NTimeout = NClients = NNoRoom = NSlack = NRep = NSame = NEmpty = NGap = 0;
     for (int& b : Bucket) b = 0;
     SlackMin = SlackMax = SlackSum = CntMin = CntMax = CntSum = GapSum = 0;
@@ -1128,6 +1202,7 @@ void Wifi::TXSendFrame(const TXSlot* slot, int num)
         IncrementTXCount(slot);
         if (erep::Pending) { erep::Late(erep::KFrame, TXBuffer, 12+len, USTimestamp); break; }  // sent at the CMD's arrival
         Platform::MP_SendReply(TXBuffer, 12+len, USTimestamp, IOPORT(W_AIDLow), NDS.UserData);
+        hold::Replied(hold::RFrameEnd, USTimestamp);
         break;
 
     case 4:
@@ -1182,10 +1257,33 @@ void Wifi::StartTX_Cmd()
 
     cdiag::Start(CmdCounter, duration, USTimestamp, NumClients(MPClientMask), slot->Length);
 
+    hold::PreSent = false;
+    hold::Armed = false;
+    const u32 promised = hold::Promised;
+    hold::LastUS = 0;
     if (CmdCounter > (duration + 100))
     {
         slot->CurPhase = 0;
         slot->CurPhaseTime = PreambleLen(slot->Rate);
+
+        // Pixelado 0009: held back within the window, and sent to the clients now with the time it will go out
+        const int maxus = hold::MaxUS();
+        if (maxus > 0 && !IsMPClient && CmdCounter > duration + hold::kMargin)   // (only the host uses the CMD slot; its IsMP stays false)
+        {
+            u32 h = std::min((u32)maxus, CmdCounter - duration - hold::kMargin) & ~(u32)(kTimerInterval - 1);
+            // the hold promised to the clients, from the window's reserve if need be (StartTX_Cmd asks for 100 us)
+            if (h < promised && CmdCounter >= duration + 100 + promised) h = promised;
+            if (h >= (u32)kTimerInterval)
+            {
+                slot->CurPhase = 14;
+                slot->CurPhaseTime = h;
+                hold::Armed = true;   // (sent at the slot's start: ProcessTX)
+                hold::NHeld++; hold::SumUS += h;
+                hold::LastUS = h;
+                hold::Recent[hold::RecentI] = h; hold::RecentI = (hold::RecentI + 1) % 32;
+                if (hold::RecentN < 32) hold::RecentN++;
+            }
+        }
     }
     else
     {
@@ -1193,6 +1291,8 @@ void Wifi::StartTX_Cmd()
         slot->CurPhaseTime = CmdCounter - 100;
     }
 
+    if (promised && hold::LastUS < promised) hold::NShort++;   // (Pixelado 0009: a promise the window couldn't keep)
+
     // starting a CMD transfer wakes up the transceiver automatically
     UpdatePowerStatus(1);
 }
@@ -1293,6 +1393,7 @@ void Wifi::SendMPDefaultReply()
     diag::Frame("TX", diag::TxRates, reply, 12+28, "default-reply", USTimestamp);
     if (erep::Pending) { erep::Late(erep::KDefault, reply, 12+28, USTimestamp); return; }  // sent at the CMD's arrival
     int txlen = Platform::MP_SendReply(reply, 12+28, USTimestamp, IOPORT(W_AIDLow), NDS.UserData);
+    hold::Replied(hold::RDefaultEnd, USTimestamp);
     WIFI_LOG("wifi: sent %d/40 bytes of MP default reply\n", txlen);
 }
 
@@ -1395,13 +1496,16 @@ void Wifi::SendMPAck(u16 cmdcount, u16 clientfail)
             nextbeacon = 0;
         else
             nextbeacon = ((IOPORT(W_BeaconCount1) - 1) << 10) + (0x400 - (USCounter & 0x3FF));
-        int runahead = std::min(CmdCounter, nextbeacon);
+        // Pixelado 0009: plus the hold the next CMD will get (this one's), so a held CMD costs the clients nothing
+        hold::Promised = hold::Promise();
+        int runahead = std::min(CmdCounter + hold::Promised, nextbeacon);
         if (CmdCounter < 1000) runahead -= 210;
         *(u32*)&ack[0] = std::max(runahead - (32*(TXSlots[1].Rate==2?4:8)), 0);
     }
     else
     {
         *(u32*)&ack[0] = PreambleLen(TXSlots[1].Rate);
+        hold::Promised = 0;   // (Pixelado 0009: no run-ahead given, none promised)
     }
 
     diag::Frame("TX", diag::TxRates, ack, 12+32, "ack", USTimestamp);
@@ -1411,6 +1515,17 @@ void Wifi::SendMPAck(u16 cmdcount, u16 clientfail)
 
 bool Wifi::ProcessTX(TXSlot* slot, int num)
 {
+    if (num == 1 && slot->CurPhase == 14 && hold::Armed)
+    {
+        // Pixelado 0009: the CMD slot's first tick: the CMD goes out to the clients now, stamped with the moment its
+        // preamble will end (this tick takes kTimerInterval of the hold), as the preamble's end would stamp it
+        hold::Armed = false;
+        const u64 now = USTimestamp;
+        USTimestamp = now + slot->CurPhaseTime - kTimerInterval + PreambleLen(slot->Rate);
+        TXSendFrame(slot, 1);
+        USTimestamp = now;
+        hold::PreSent = true;
+    }
     slot->CurPhaseTime -= kTimerInterval;
     if (slot->CurPhaseTime > 0)
     {
@@ -1469,7 +1584,9 @@ bool Wifi::ProcessTX(TXSlot* slot, int num)
             // set TX addr
             IOPORT(W_RXTXAddr) = slot->Addr >> 1;
 
-            if (num != 5)
+            if (num == 1 && hold::PreSent)
+                hold::PreSent = false;   // (Pixelado 0009: already sent at the hold's start, stamped with this moment)
+            else if (num != 5)
             {
                 TXSendFrame(slot, num);
             }
@@ -1497,6 +1614,13 @@ bool Wifi::ProcessTX(TXSlot* slot, int num)
         }
         break;
 
+    case 14: // Pixelado 0009: the CMD's hold is over: its preamble starts, as StartTX_Cmd would have
+        {
+            slot->CurPhase = 0;
+            slot->CurPhaseTime = PreambleLen(slot->Rate);
+        }
+        break;
+
     case 10: // preamble done (default empty MP reply)
         {
             SetIRQ(7);
@@ -1992,7 +2116,7 @@ void Wifi::FinishRX()
                 Log(LogLevel::Debug, "[diag] TX MP-REPLY blank (AID=%d, clientmask=%04X) ts=%llu\n",
                     IOPORT(W_AIDLow), clientmask, (unsigned long long)USTimestamp);
             if (erep::Pending) erep::Late(erep::KBlank, nullptr, 0, USTimestamp);  // sent at the CMD's arrival
-            else Platform::MP_SendReply(nullptr, 0, USTimestamp, 0, NDS.UserData);
+            else { Platform::MP_SendReply(nullptr, 0, USTimestamp, 0, NDS.UserData); hold::Replied(hold::RBlank, USTimestamp); }
         }
     }
     else if ((rxflags & 0x800F) == 0x8001)
@@ -2095,6 +2219,18 @@ bool Wifi::CheckRX(int type) // 0=regular 1=MP replies 2=MP host frames
             }
             else if (rxlen == 0 && IsMPClient)
             {
+                if (cdiag::On() && hold::NWaitLogs < 400)
+                {
+                    hold::NWaitLogs++;
+                    const u64 nowus = Platform::GetUSCount();
+                    Log(LogLevel::Info, "[diag] LAN client wait: timed out at US=%llu NextSync=%llu; last CMD ts=%llu "
+                        "(US %+lld us from it) late=%d, got %.1f ms ago; its reply: %s ts=%llu, %.1f ms ago; early pending=%d\n",
+                        (unsigned long long)USTimestamp, (unsigned long long)NextSync, (unsigned long long)hold::LastCmdTS,
+                        (long long)(USTimestamp - hold::LastCmdTS), hold::LastCmdLate ? 1 : 0,
+                        hold::LastCmdAt ? (nowus - hold::LastCmdAt) / 1000.0 : -1.0, hold::RName[hold::LastReplyKind],
+                        (unsigned long long)hold::LastReplyTS, hold::LastReplyAt ? (nowus - hold::LastReplyAt) / 1000.0 : -1.0,
+                        erep::Pending ? 1 : 0);
+                }
                 // BananaDS: a host that stopped talking (its game quit while the session stays up, as a Banana Party
                 // room keeps it) doesn't hold this console. Each tick past NextSync waits a full MP receive timeout
                 // for it, and NextSync only moves with a host frame: emulated time stood still, a frame took ~50 s
@@ -2223,7 +2359,19 @@ bool Wifi::CheckRX(int type) // 0=regular 1=MP replies 2=MP host frames
         // we also need to determine how far we can run after having received this frame
 
         RXTimestamp = timestamp;
-        if (RXTimestamp < USTimestamp) RXTimestamp = USTimestamp;
+        const bool late = RXTimestamp < USTimestamp;
+        if (late)
+        {
+            // Pixelado 0009 diag: a host frame stamped before this client's time (it ran too far): clamped for good
+            hold::NLate++; hold::LateUS += USTimestamp - RXTimestamp;
+            RXTimestamp = USTimestamp;
+        }
+        if (MACEqual(&RXBuffer[12 + 4], MPCmdMAC))
+        {
+            hold::LastCmdTS = timestamp; hold::LastCmdAt = Platform::GetUSCount(); hold::LastCmdLate = late;
+            hold::LastReplyKind = hold::RNone;
+        }
+        hold::LateFlush();
         NextSync = RXTimestamp + (framelen * (txrate==0x14 ? 4:8));
 
         if (MACEqual(&RXBuffer[12 + 4], MPCmdMAC))
@@ -2272,6 +2420,7 @@ bool Wifi::CheckRX(int type) // 0=regular 1=MP replies 2=MP host frames
                         if (noseqno == 2) *(u16*)&b[0xC] |= (1<<11);
                         b[9] = CurChannel;
                         Platform::MP_SendReply(b, 12 + len, ts, IOPORT(W_AIDLow), NDS.UserData);
+                        hold::Replied(hold::REarly, ts);
                         erep::Sent(erep::KFrame, 12 + len, ts);
                     }
                     else
