+#ifdef BANANADS_LAN
+// The round trip the Party shows, measured for real. ENet's (melonDS's Player::Ping) counts the time until the other
+// emulator services the network, once a frame in the room: 16-24 ms shown for a network of 2-3 ms (2026-11-21). So
+// each console answers a small UDP echo on its own thread, at once, and asks every player of the session for one
+// each second; the Party shows the median of the last 5. A player that doesn't answer (an older build) keeps ENet's.
+namespace lanecho {
+static constexpr uint16_t kPort = 7065;          // (7063: discovery, 7064: the session)
+static std::mutex mu;
+static std::map<uint32_t, std::deque<double>> rtt;  // network-order IPv4 -> the last round trips, ms
+static std::vector<uint32_t> targets;
+static std::atomic<bool> started{false};
+
+static double now_ms() {
+    timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return ts.tv_sec * 1000.0 + ts.tv_nsec / 1e6;
+}
+
+static void loop(int fd) {
+    double next = 0;
+    uint32_t seq = 0;
+    for (;;) {
+        const double t = now_ms();
+        if (t >= next) {
+            next = t + 1000;
+            std::vector<uint32_t> to;
+            { std::lock_guard<std::mutex> l(mu); to = targets; }
+            for (uint32_t a : to) {
+                unsigned char m[16] = {'B', 'P', 'E', '?'};
+                ++seq;
+                memcpy(m + 4, &seq, 4);
+                const double now = now_ms();
+                memcpy(m + 8, &now, 8);
+                sockaddr_in sa{};
+                sa.sin_family = AF_INET;
+                sa.sin_port = htons(kPort);
+                sa.sin_addr.s_addr = a;
+                sendto(fd, m, sizeof m, 0, (sockaddr*)&sa, sizeof sa);
+            }
+        }
+        pollfd pf{fd, POLLIN, 0};
+        if (poll(&pf, 1, 100) <= 0) continue;
+        unsigned char m[64];
+        sockaddr_in from{};
+        socklen_t fl = sizeof from;
+        const ssize_t n = recvfrom(fd, m, sizeof m, 0, (sockaddr*)&from, &fl);
+        if (n != 16 || m[0] != 'B' || m[1] != 'P' || m[2] != 'E') continue;
+        if (m[3] == '?') {   // someone's echo: back at once
+            m[3] = '!';
+            sendto(fd, m, 16, 0, (sockaddr*)&from, fl);
+        } else if (m[3] == '!') {
+            double sent;
+            memcpy(&sent, m + 8, 8);
+            const double r = now_ms() - sent;
+            if (r < 0 || r > 2000) continue;
+            std::lock_guard<std::mutex> l(mu);
+            auto& d = rtt[from.sin_addr.s_addr];
+            d.push_back(r);
+            while (d.size() > 5) d.pop_front();
+        }
+    }
+}
+
+static void start() {
+    if (started.exchange(true)) return;
+    const int fd = socket(AF_INET, SOCK_DGRAM, 0);
+    if (fd < 0) return;
+    int one = 1;
+    setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, &one, sizeof one);
+    sockaddr_in sa{};
+    sa.sin_family = AF_INET;
+    sa.sin_port = htons(kPort);
+    sa.sin_addr.s_addr = htonl(INADDR_ANY);
+    if (bind(fd, (sockaddr*)&sa, sizeof sa) != 0) {
+        Log(LogLevel::Warn, "[wifi] latency echo: UDP %d taken: the Party shows ENet's round trip\n", kPort);
+        close(fd);
+        return;
+    }
+    Log(LogLevel::Info, "[wifi] latency echo on UDP %d\n", kPort);
+    std::thread(loop, fd).detach();
+}
+
+static void set_targets(std::vector<uint32_t> t) {
+    std::lock_guard<std::mutex> l(mu);
+    targets = std::move(t);
+    for (auto it = rtt.begin(); it != rtt.end();)   // (players gone: forgotten)
+        it = std::find(targets.begin(), targets.end(), it->first) == targets.end() ? rtt.erase(it) : std::next(it);
+}
+
+static int ms(uint32_t a) {   // the median of the last round trips, rounded; -1: none yet
+    std::lock_guard<std::mutex> l(mu);
+    auto it = rtt.find(a);
+    if (it == rtt.end() || it->second.empty()) return -1;
+    std::vector<double> v(it->second.begin(), it->second.end());
+    std::sort(v.begin(), v.end());
+    const double m = v[v.size() / 2];
+    return m < 1 ? 1 : (int)(m + 0.5);
+}
+}
