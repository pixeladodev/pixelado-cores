@@ -2547,6 +2549,30 @@ bool Emu::load_rom(const std::string& path) {
 #endif
             nds_->SetRenderer(std::make_unique<GengisSoftRenderer>(*nds_, threads, defer));
     } else
+#else
+    // Pixelado: render.renderer=gengis (the default) with the user's plugin (src/gengis_plugin.h), the same settings
+    if (const GengisPlugin* gp = cfg_.str("render.renderer", "gengis") == "gengis"
+            ? gengis_plugin(cfg_.str("render.gengis_plugin", "")) : nullptr) {
+        const int threads = (int)cfg_.num("render.gengis_threads", 3);
+        const bool defer = cfg_.flag("render.gengis_defer", false);
+        static const struct { const char* key; const char* name; long def; } sets[] = {
+            {"render.gengis_help", "help", 1}, {"sched.gengis_nice", "nice", 0}, {"render.gengis_wake", "wake", 1},
+            {"render.gengis_stats", "stats", 0}, {"render.gengis_hrneon", "hrneon", -1}, {"render.gengis_verify", "verify", 0},
+            {"render.gengis_lazy", "lazy", 0}, {"render.gengis_units", "units", 3}, {"render.gengis_units_low", "units_low", 2},
+            {"render.gengis_keyskip", "keyskip", 1}, {"render.gengis_vbwait", "vbwait", -1}, {"render.gengis_crc", "crc", 0},
+            {"render.gengis_texinval", "texinval", 1}, {"render.gengis_zva", "zva", 1}, {"render.gengis_trim", "trim", 1},
+            {"render.gengis_reuse", "reuse", 1},
+        };
+        for (const auto& e : sets) gp->set(e.name, cfg_.num(e.key, e.def));
+        gp->set_effects(cfg_.flag("render.edge_marking", true), cfg_.flag("render.fog", true));
+#ifdef BANANADS_2D
+        if (banana2d) {
+            nds_->SetRenderer(std::make_unique<GengisPluginOn<melonDS::BananaRenderer>>(*nds_, gp, threads, defer, scale));
+            scale_ = scale;
+        } else
+#endif
+            nds_->SetRenderer(std::make_unique<GengisPluginOn<melonDS::SoftRenderer>>(*nds_, gp, threads, defer));
+    } else
 #endif
     {
 #ifdef BANANADS_2D
