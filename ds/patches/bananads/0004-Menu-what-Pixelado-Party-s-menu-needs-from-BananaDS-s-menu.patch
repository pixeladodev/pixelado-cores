         }
+        // the game this run plays: in a Party room the command line names the room's own program (lobby.nds), and the
+        // game chosen there came after it (load_rom): the menu's name and the swap kept per game are that one's
+        if (!emu.rom_path().empty()) mh.rom = emu.rom_path();
+        else if (emu.game() == "DS firmware") mh.rom = "@firmware";
         if (swap_remembered(mh.rom)) {
             dp.swapped = true;
             Log(LogLevel::Info, "[kms] screens swapped for this game (F + SELECT, remembered)\n");
