+/* ---------- Pixelado Party's menu (partyctl.h): Party draws it; its settings are done here, as this menu does them ------ */
+static int ext_fps_opt(void) {   /* the frontend's FPS counter option (an on/off one), -1: none */
+    for (int n = H.opt_count ? H.opt_count(H.ctx) : 0, i = 0; i < n; i++)
+        if (H.opt_label && !strcmp(H.opt_label(H.ctx, i), "FPS counter") && H.opt_values && H.opt_values(H.ctx, i) == 2) return i;
+    return -1;
+}
+void bmenu_ext_open(int *v, int *b, int *f) {
+    sounds_load();
+    snd_on = banana_menu_sounds();
+    vol = volume_get(); if (vol < 0) vol = 50;
+    bri = brightness_get();
+    bri_changed = 0;
+    *v = vol; *b = bri;
+    const int fo = ext_fps_opt();
+    *f = fo >= 0 && H.opt_get ? H.opt_get(H.ctx, fo) != 0 : -1;
+}
+void bmenu_ext_set(const char *key, int v) {
+    if (!strcmp(key, "volume")) { v = v < 0 ? 0 : v > 100 ? 100 : v; if (v != vol) { vol = v; want(vol, -1); } }
+    else if (!strcmp(key, "brightness")) bri_set(v);
+    else if (!strcmp(key, "fps")) { const int fo = ext_fps_opt(); if (fo >= 0 && H.opt_set) H.opt_set(H.ctx, fo, v != 0); }
+}
+int bmenu_ext_tick(int *v, int *b) {   /* every 500 ms while Party's menu is open: the handheld's keys (bananad) */
+    const long long t = now_ms();
+    int changed = 0;
+    want_ex(-1, -1, 1);
+    int r = vol_read;
+    if (r >= 0) { vol_read = -1; if (r != vol && t - vol_set_at > 1500) { vol = r; changed = 1; } }
+    if (t - bri_set_at > 1500) {
+        int n = 0, sum = 0;
+        for (int i = 0; i < 2; i++) { int x = bl_pm(i); if (x > 0) { sum += x; n++; } }
+        int nb = n ? (sum / n + 5) / 10 : bri;
+        if (nb - bri >= 3 || bri - nb >= 3) { bri = brightness_get(); changed = 1; }
+    }
+    *v = vol; *b = bri;
+    return changed;
+}
+void bmenu_ext_close(void) { bri_save_now(); }
+void bmenu_ext_sound(int id) { if (id >= 0 && id < SND_N) play(id); }
