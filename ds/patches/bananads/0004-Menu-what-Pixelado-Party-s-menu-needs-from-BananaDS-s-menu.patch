+static int junk_name(const char *t) {   /* a file name that says nothing: "4785", "x", "rom" */
+    int letters = 0;
+    for (const char *p = t; *p; p++) if (isalpha((unsigned char)*p)) letters++;
+    return letters < 2 || !strcasecmp(t, "rom") || !strcasecmp(t, "game");
+}
+/* the cartridge banner's title (English), its first line, UTF-16 to UTF-8 */
+static void banner_title(const char *path, char *out, size_t n) {
+    out[0] = 0;
+    size_t l = strlen(path);
+    if (l < 4 || (strcasecmp(path + l - 4, ".nds") && strcasecmp(path + l - 4, ".dsi"))) return;
+    FILE *f = fopen(path, "rb"); if (!f) return;
+    uint8_t h[4], t[256];
+    if (!fseek(f, 0x68, SEEK_SET) && fread(h, 1, 4, f) == 4) {
+        const uint32_t off = h[0] | h[1] << 8 | h[2] << 16 | (uint32_t)h[3] << 24;
+        if (off >= 0x200 && !fseek(f, (long)off + 0x340, SEEK_SET) && fread(t, 1, sizeof t, f) == sizeof t) {
+            size_t k = 0;
+            for (int i = 0; i < 128 && k + 4 < n; i++) {
+                unsigned cp = t[2 * i] | t[2 * i + 1] << 8;
+                if (!cp || cp == '\n') break;
+                if (cp < 0x80) out[k++] = (char)cp;
+                else if (cp < 0x800) { out[k++] = (char)(0xC0 | cp >> 6); out[k++] = (char)(0x80 | (cp & 63)); }
+                else { out[k++] = (char)(0xE0 | cp >> 12); out[k++] = (char)(0x80 | (cp >> 6 & 63)); out[k++] = (char)(0x80 | (cp & 63)); }
+            }
+            out[k] = 0;
+        }
+    }
+    fclose(f);
+}
