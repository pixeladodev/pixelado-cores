 #endif
 }
 
+// the room's pause: our menu's state to the room (LAN::SetHold sends it only when it changes), and who else holds it
+void Emu::lan_hold_tick() {
+#ifdef BANANADS_LAN
+    uint16_t mask = 0;
+    if (local_ && MPInterface::GetType() == MPInterface_LAN) {
+        LAN& lan = static_cast<LAN&>(MPInterface::Get());
+        lan.SetHold(my_hold_.load(std::memory_order_relaxed));
+        mask = lan.GetHoldMask();
+        const int me = lan.GetMyID();
+        if (me >= 0 && me < 16) mask &= (uint16_t)~(1u << me);
+        if (mask != hold_mask_) {
+            std::string names;
+            int n = 0;
+            for (const LAN::Player& p : lan.GetPlayerList())
+                if (p.ID >= 0 && p.ID < 16 && (mask & (1u << p.ID)) && p.Status != LAN::Player_Disconnected) {
+                    names += (n++ ? "\n" : "") + std::string(p.Name, strnlen(p.Name, sizeof p.Name));
+                }
+            if (!n) n = __builtin_popcount(mask);   // (a player not in the list yet: counted all the same)
+            {
+                std::lock_guard<std::mutex> l(lan_mu_);
+                hold_names_ = names;
+            }
+            Log(LogLevel::Info, "[wifi] the room's pause: %d other player%s in the menu (%04X)\n", n, n == 1 ? "" : "s", mask);
+            hold_mask_ = mask;
+            hold_others_.store(mask ? n : 0, std::memory_order_release);
+            lan_refresh(true);   // (the players' hold marks)
+        }
+        return;
+    }
+#endif
+    if (hold_mask_) {
+        hold_mask_ = 0;
+        hold_others_.store(0, std::memory_order_release);
+    }
+}
+
+std::string Emu::room_hold_names() const {
+    std::lock_guard<std::mutex> l(lan_mu_);
+    return hold_names_;
+}
+
+void Emu::net_resumed() {
+#ifdef BANANADS_LAN
+    std::lock_guard<std::mutex> g(net_mu_);
+    if (local_ && MPInterface::GetType() == MPInterface_LAN) static_cast<LAN&>(MPInterface::Get()).HoldResumed();
+    if (nds_) nds_->Wifi.NetResumed();
+#endif
+}
